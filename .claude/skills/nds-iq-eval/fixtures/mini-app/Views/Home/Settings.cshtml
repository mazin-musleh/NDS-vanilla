@{
    ViewData["Title"] = "Settings";
}
<!-- Built on NDS. Carries a Save button for the styling scenarios to retune. -->
<div class="nds-content-layout">
    <div class="nds-main-content">
        <section class="nds-content-section">
            <div class="nds-section-wrapper">
                <div class="nds-section-head">
                    <h2 class="nds-section-title">Settings</h2>
                </div>
                <div class="nds-section-body">
                    <div class="nds-block">
                        <div class="nds-form-container">
                            <div class="nds-form-control">
                                <input type="text" class="nds-input" placeholder="Display name">
                            </div>
                        </div>
                        <div class="nds-card-actions">
                            <button class="nds-btn nds-primary" type="submit">
                                <span class="nds-label">Save</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
