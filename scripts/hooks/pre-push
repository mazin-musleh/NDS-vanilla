#!/bin/sh
# Raw main serves _includes/NDS-IQ.md to every install; only scripts/publish-iq.py writes it.
# Install once per clone: git config core.hooksPath scripts/hooks
while read -r lref lsha rref rsha; do
  [ "$rref" = refs/heads/main ] || continue
  case $lsha in 0000000000000000000000000000000000000000) continue ;; esac
  # Only tags in main's history count: a frozen old-line tag (IQv3.2) lives off main.
  tag=$(git tag -l 'IQv*' --merged "$lsha" --sort=-v:refname | head -n 1)
  [ -n "$tag" ] || continue
  if ! git diff --quiet "$tag" "$lsha" -- _includes/NDS-IQ.md; then
    echo "pre-push: _includes/NDS-IQ.md on main differs from $tag, and raw main publishes it." >&2
    echo "Edit _includes/NDS-IQ-draft.md instead, and publish with: python scripts/publish-iq.py" >&2
    exit 1
  fi
done
